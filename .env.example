# Public base URL (used for canonical URLs, sitemap and Open Graph)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# PostgreSQL connection string
DATABASE_URL=postgres://powerhouse:powerhouse_dev@localhost:5432/powerhouse
# Set to "true" for managed databases that require TLS
DATABASE_SSL=false
DATABASE_POOL_MAX=5

# Salt for hashing IP addresses used in rate limiting (any long random string)
RATE_LIMIT_SALT=change-me-to-a-long-random-string

# --- Optional: email notifications for new enquiries (Resend) ---
# Leave blank to disable. Enquiries are always saved to the database.
RESEND_API_KEY=
NOTIFY_EMAIL_TO=
EMAIL_FROM=
